{
  "info": {
    "name": "SG Journey Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "dataGov", "value": "https://api-open.data.gov.sg/v2/real-time/api" }
  ],
  "item": [
    {
      "name": "Our API",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ] } }]
        },
        {
          "name": "Weather (City)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/weather?area=City", "host": ["{{baseUrl}}"], "path": ["weather"], "query": [{ "key": "area", "value": "City" }] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "// Returns 501 until weather.service.js is implemented.",
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has condition', () => pm.expect(['clear','light','heavy']).to.include(pm.response.json().condition));"
          ] } }]
        },
        {
          "name": "Weather (unknown area)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/weather?area=Nowhere", "host": ["{{baseUrl}}"], "path": ["weather"], "query": [{ "key": "area", "value": "Nowhere" }] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));"
          ] } }]
        }
      ]
    },
    {
      "name": "data.gov.sg (upstream)",
      "item": [
        { "name": "2-hour forecast", "request": { "method": "GET", "url": "{{dataGov}}/two-hr-forecast" } },
        { "name": "Air temperature", "request": { "method": "GET", "url": "{{dataGov}}/air-temperature" } },
        { "name": "Rainfall", "request": { "method": "GET", "url": "{{dataGov}}/rainfall" } },
        { "name": "24-hour forecast", "request": { "method": "GET", "url": "{{dataGov}}/twenty-four-hr-forecast" } }
      ]
    }
  ]
}
