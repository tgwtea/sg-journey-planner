# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

PORT=3000

# Comma-separated list of allowed browser origins (local dev).
# On Vercel the frontend and API share one origin, so CORS is not needed there.
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string. Leave empty to run without a database.
MONGODB_URI=

# LTA DataMall AccountKey (request one at https://datamall.lta.gov.sg).
LTA_ACCOUNT_KEY=

# Optional data.gov.sg API key (raises rate limits). Not required.
DATA_GOV_SG_API_KEY=
